<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher background: a flat yellow field.

  Adaptive icon backgrounds have to cover the whole 108x108dp viewport with no transparency,
  because the launcher mask decides what of it survives and any gap shows as a hole.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#FFD500" />

</vector>
