<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: a folded paper plane, sticker style - white keyline, dark outline, one
  orange face for the underside of the near wing, and a flat drop shadow.

  Adaptive icons are 108x108dp but only the centre 72dp (18..90) is guaranteed to survive the
  launcher's mask, and the mask differs per device. The plane sits inside 25..80 on x and 30..78
  on y so nothing can clip the nose or the tails; only the shadow runs out towards the corner,
  where losing an edge of it costs nothing.

  The whole plane is six points - nose, rear tip, notch, tail tip, fold, left tip - and the three
  faces are that outline split by the two lines running back from the nose. Changing a point means
  changing it in the outline, the face that uses it and the shadow.

  Themed (monochrome) icons get their own drawable: the system tints a silhouette flat, so the
  shadow and the faces would collapse into one blob here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Drop shadow: the same outline, pushed down-right, in a darker yellow. -->
    <path
        android:pathData="M89,37 L78,85 L60,73 L51,83 L44,64 L34,55 Z"
        android:fillColor="#E8C000"
        android:strokeColor="#E8C000"
        android:strokeWidth="6"
        android:strokeLineJoin="round" />

    <!-- White keyline: the outline, fattened, so the plane sits clear of the background. -->
    <path
        android:pathData="M80,30 L69,78 L51,66 L42,76 L35,57 L25,48 Z"
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="11"
        android:strokeLineJoin="round" />

    <!-- Far wing: left tip, nose, fold. -->
    <path
        android:pathData="M25,48 L80,30 L35,57 Z"
        android:fillColor="#565A63" />

    <!-- Underside of the near wing, the one face that catches the light. -->
    <path
        android:pathData="M35,57 L80,30 L42,76 Z"
        android:fillColor="#F99B1C" />

    <!-- Near wing: nose, rear tip, notch, tail tip. -->
    <path
        android:pathData="M80,30 L69,78 L51,66 L42,76 Z"
        android:fillColor="#4A4D54" />

    <!-- Outline, drawn last so it sits over the seams between the faces. -->
    <path
        android:pathData="M80,30 L69,78 L51,66 L42,76 L35,57 L25,48 Z"
        android:fillColor="#00000000"
        android:strokeColor="#231F20"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round" />

    <!-- The two folds, both running back from the nose. -->
    <path
        android:pathData="M80,30 L35,57"
        android:fillColor="#00000000"
        android:strokeColor="#231F20"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M80,30 L42,76"
        android:fillColor="#00000000"
        android:strokeColor="#231F20"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />

</vector>
