# Gradle files
.gradle/
build/
/build
/captures

# Local configuration file (sdk path, etc)
local.properties

# Log/OS files
*.log
.DS_Store

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.apk
output.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files and the signing credentials that point at them.
# keystore.properties holds passwords in plain text - it must never be committed.
*.jks
*.keystore
keystore.properties

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android profiling
*.hprof

# DexHolder.java is generated by the :app:generateDexHolder task into
# app/build/generated/sources/dexholder, which is already covered by build/ above.
